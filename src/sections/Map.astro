---
import LeafletMap from "@/components/LeafletMap.astro";
import SectionTitle from "@/components/SectionTitle.astro";
---

<section class="pb-section-vertical">
  <SectionTitle>Ubicación</SectionTitle>
  <p class="text-sm text-balance text-gray-700 mb-4">
    Puedes encontranos en la <strong>Calle 54 No 45 92</strong>. A pocos minutos
    de la estación Prado ó Parque Berrio.
  </p>
  <LeafletMap
    latitude={6.251192317432918}
    longitude={-75.56305533963186}
    zoom={16}
    container="map-container"
    tileLayer="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
    attribution="© OpenStreetMap contributors"
  />
</section>
